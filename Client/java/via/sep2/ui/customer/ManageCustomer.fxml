                <ImageView fitHeight="77.0" fitWidth="77.0" pickOnBounds="true" preserveRatio="true">
                    <image>
                        <Image url="@../images/refresh.png" />
                    </image>
                    <HBox.margin>
                        <Insets bottom="5.0" left="8.0" right="5.0" top="5.0" />
                    </HBox.margin>
                </ImageView>
                <Button fx:id="updateButton" mnemonicParsing="false" onAction="#onUpdate" prefHeight="83.0" prefWidth="154.0" styleClass="normalbutton" text="Update a &#10;Customer" textFill="WHITE">
                    <HBox.margin>
                        <Insets bottom="8.0" left="8.0" right="8.0" top="8.0" />
                    </HBox.margin>
                    <font>
                        <Font name="Franklin Gothic Medium" size="25.0" />
                    </font>
                </Button>
            </children>
        </HBox>
        <Text fill="#878787" layoutX="710.0" layoutY="490.0" strokeType="OUTSIDE" strokeWidth="0.0">
            <font>
                <Font name="Cambria Bold" size="30.0" />
            </font>
        </Text>
        <Text fill="#878787" layoutX="710.0" layoutY="455.0" strokeType="OUTSIDE" strokeWidth="0.0">
            <font>
                <Font name="Cambria" size="30.0" />
            </font>
        </Text>
      <Label fx:id="messageLabel" alignment="CENTER" layoutX="751.0" layoutY="516.0" prefHeight="87.0" prefWidth="312.0" text="Label for stuff" textFill="#6b0000" wrapText="true">
         <font>
            <Font name="Franklin Gothic Medium" size="20.0" />
         </font>
      </Label>
      <HBox layoutX="773.0" layoutY="746.0" prefHeight="87.0" prefWidth="268.0" styleClass="button_background">
         <children>
            <ImageView fitHeight="77.0" fitWidth="77.0" pickOnBounds="true" preserveRatio="true">
               <image>
                  <Image url="@../images/returnArrow.png" />
               </image>
               <HBox.margin>
                  <Insets bottom="5.0" left="8.0" right="5.0" top="5.0" />
               </HBox.margin>
            </ImageView>
            <Button alignment="CENTER" mnemonicParsing="false" onAction="#onReturn" prefHeight="83.0" prefWidth="154.0" styleClass="normalbutton" text="Return to&#10;Customer Add&#10;" textAlignment="CENTER" textFill="WHITE">
               <HBox.margin>
                  <Insets bottom="8.0" left="8.0" right="8.0" top="8.0" />
               </HBox.margin>
               <font>
                  <Font name="Franklin Gothic Medium" size="17.0" />
               </font>
            </Button>
         </children>
      </HBox>
      <VBox layoutX="41.0" layoutY="38.0" prefHeight="835.0" prefWidth="588.0" styleClass="table_background" />
