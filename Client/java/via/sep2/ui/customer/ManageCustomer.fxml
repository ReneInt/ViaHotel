<AnchorPane prefHeight="900.0" prefWidth="1200.0" styleClass="mainPane_background" xmlns="http://javafx.com/javafx/22" xmlns:fx="http://javafx.com/fxml/1" fx:controller="via.sep2.ui.customer.ManageCustomerController">
    <children>
