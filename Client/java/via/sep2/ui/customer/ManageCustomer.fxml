               </HBox.margin>
               <font>
                  <Font name="Franklin Gothic Medium" size="24.0" />
               </font>
            </Button>
         </children>
      </HBox>
      <TextField fx:id="enterEmail" layoutX="643.0" layoutY="283.0" prefHeight="63.0" prefWidth="217.0" promptText="Type email" styleClass="text_field">
         <font>
            <Font name="Franklin Gothic Medium" size="18.0" />
         </font>
      </TextField>
      <Button layoutX="896.0" layoutY="283.0" mnemonicParsing="false" onAction="#onSearch" prefHeight="63.0" prefWidth="66.0" styleClass="search_button" />
      <VBox layoutX="61.0" layoutY="58.0" prefHeight="808.0" prefWidth="550.0" styleClass="table_background">
         <children>
            <TableView fx:id="personTable" fixedCellSize="0.0" prefHeight="758.0" prefWidth="500.0">
               <VBox.margin>
                  <Insets bottom="25.0" left="25.0" right="25.0" top="25.0" />
               </VBox.margin>
               <columns>
                  <TableColumn fx:id="firstNameColumn" prefWidth="150.0" text="First Name" />
                  <TableColumn fx:id="lastNameColumn" prefWidth="150.0" text="Last Name" />
                  <TableColumn fx:id="emailColumn" prefWidth="200.0" text="Email" />
               </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
            </TableView>
         </children>
      </VBox>
      <Label fx:id="errorLabel" alignment="CENTER" contentDisplay="CENTER" disable="true" layoutX="86.0" layoutY="86.0" prefHeight="758.0" prefWidth="500.0" text="error" textAlignment="CENTER" textFill="RED" wrapText="true">
         <font>
            <Font size="50.0" />
