<AnchorPane prefHeight="600.0" prefWidth="800.0" styleClass="mainPane_background" xmlns="http://javafx.com/javafx/22" xmlns:fx="http://javafx.com/fxml/1" fx:controller="via.sep2.ui.login.LoginController">
