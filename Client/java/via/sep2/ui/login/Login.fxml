      </Text>
      <PasswordField fx:id="passwordInput" layoutX="98.0" layoutY="266.0" prefHeight="42.0" prefWidth="232.0" promptText="Type your password" styleClass="text_field" AnchorPane.leftAnchor="100.0" AnchorPane.rightAnchor="469.0">
