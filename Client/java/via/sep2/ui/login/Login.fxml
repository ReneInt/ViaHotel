               <image>
                  <Image url="@../images/addNewUser.png" />
               </image>
            </ImageView>
            <Button mnemonicParsing="false" onAction="#onRegister" prefHeight="75.0" prefWidth="85.0" styleClass="normalbutton" text="Sign up" textAlignment="CENTER" textFill="WHITE">
