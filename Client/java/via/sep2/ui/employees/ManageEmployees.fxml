      </Text>
      <Text fill="#898989" layoutX="942.0" layoutY="161.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Manage">
         <font>
            <Font name="Cambria" size="55.0" />
         </font>
      </Text>
      <TextField fx:id="firstName" layoutX="656.0" layoutY="341.0" prefHeight="64.0" prefWidth="217.0" promptText="Type First Name" styleClass="text_field">
         <font>
            <Font name="Franklin Gothic Medium" size="18.0" />
         </font>
      </TextField>
      <TextField fx:id="lastName" layoutX="925.0" layoutY="341.0" prefHeight="64.0" prefWidth="217.0" promptText="Type Last Name" styleClass="text_field">
         <font>
            <Font name="Franklin Gothic Medium" size="18.0" />
         </font>
      </TextField>
      <HBox layoutX="649.0" layoutY="622.0" prefHeight="87.0" prefWidth="248.0" styleClass="button_background">
         <children>
            <ImageView fitHeight="96.0" fitWidth="123.0" pickOnBounds="true" preserveRatio="true">
               <image>
                  <Image url="@../images/FireAnEmployee.png" />
               </image>
               <HBox.margin>
                  <Insets bottom="5.0" left="8.0" right="5.0" top="5.0" />
               </HBox.margin>
            </ImageView>
            <Button fx:id="cancelButton" mnemonicParsing="false" onAction="#onDelete" prefHeight="89.0" prefWidth="119.0" styleClass="normalbutton" text="FIRE!!!" textFill="WHITE">
               <HBox.margin>
                  <Insets bottom="8.0" left="8.0" right="8.0" top="8.0" />
               </HBox.margin>
               <font>
                  <Font name="Franklin Gothic Medium" size="24.0" />
               </font>
            </Button>
         </children>
      </HBox>
      <TextField fx:id="enterEmail" layoutX="726.0" layoutY="223.0" prefHeight="63.0" prefWidth="248.0" promptText="Type email" styleClass="text_field">
         <font>
            <Font name="Franklin Gothic Medium" size="18.0" />
         </font>
      </TextField>
      <Button layoutX="1000.0" layoutY="223.0" mnemonicParsing="false" onAction="#onSearch" prefHeight="63.0" prefWidth="66.0" styleClass="search_button" />
      <Text fill="#898989" layoutX="853.0" layoutY="451.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Position" wrappingWidth="88.83984375">
         <font>
            <Font name="Franklin Gothic Medium" size="23.0" />
         </font>
      </Text>
      <VBox layoutX="64.0" layoutY="53.0" prefHeight="808.0" prefWidth="550.0" styleClass="table_background">
         <children>
            <TableView fx:id="personTable" fixedCellSize="0.0" prefHeight="758.0" prefWidth="500.0">
               <VBox.margin>
                  <Insets bottom="25.0" left="25.0" right="25.0" top="25.0" />
               </VBox.margin>
               <columns>
                  <TableColumn fx:id="firstNameColumn" prefWidth="150.0" text="First Name" />
                  <TableColumn fx:id="lastNameColumn" prefWidth="150.0" text="Last Name" />
                  <TableColumn fx:id="emailColumn" prefWidth="200.0" text="Email" />
               </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
            </TableView>
         </children>
      </VBox>
      <Label fx:id="errorLabel" alignment="CENTER" contentDisplay="CENTER" disable="true" layoutX="101.0" layoutY="99.0" prefHeight="745.0" prefWidth="500.0" text="error" textAlignment="CENTER" textFill="RED" wrapText="true">
         <font>
            <Font size="50.0" />
         </font>
      </Label>
      <ComboBox fx:id="personType" layoutX="806.0" layoutY="472.0" prefHeight="43.0" prefWidth="183.0" />
    </children>
</AnchorPane>
