<AnchorPane prefHeight="900.0" prefWidth="1200.0" styleClass="mainPane_background" xmlns="http://javafx.com/javafx/22" xmlns:fx="http://javafx.com/fxml/1" fx:controller="via.sep2.ui.employees.ManageEmployeeController">
    <children>
        <HBox layoutX="911.0" layoutY="625.0" prefHeight="96.0" prefWidth="268.0" styleClass="button_background">
            <children>
                <ImageView fitHeight="85.0" fitWidth="83.0" pickOnBounds="true" preserveRatio="true">
                    <image>
                        <Image url="@../images/refresh.png" />
                    </image>
                    <HBox.margin>
                        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                    </HBox.margin>
                </ImageView>
                <Button fx:id="updateButton" mnemonicParsing="false" onAction="#onUpdate" prefHeight="109.0" prefWidth="154.0" styleClass="normalbutton" text="Update an &#10;Employee" textFill="WHITE">
                    <HBox.margin>
                        <Insets bottom="8.0" left="8.0" right="8.0" top="8.0" />
                    </HBox.margin>
                    <font>
                        <Font name="Franklin Gothic Medium" size="24.0" />
                    </font>
                </Button>
            </children>
        </HBox>
        <Text fill="#878787" layoutX="710.0" layoutY="437.0" strokeType="OUTSIDE" strokeWidth="0.0">
            <font>
                <Font name="Cambria Bold" size="30.0" />
            </font>
        </Text>
        <Text fill="#878787" layoutX="710.0" layoutY="402.0" strokeType="OUTSIDE" strokeWidth="0.0">
            <font>
                <Font name="Cambria" size="30.0" />
            </font>
        </Text>
      <Label fx:id="messageLabel" alignment="CENTER" layoutX="755.0" layoutY="535.0" prefHeight="87.0" prefWidth="312.0" text="Label for stuff" textFill="#6b0000" wrapText="true">
         <font>
            <Font name="Franklin Gothic Medium" size="20.0" />
         </font>
      </Label>
      <HBox layoutX="763.0" layoutY="728.0" prefHeight="87.0" prefWidth="268.0" styleClass="button_background">
         <children>
            <ImageView fitHeight="77.0" fitWidth="77.0" pickOnBounds="true" preserveRatio="true">
               <image>
                  <Image url="@../images/returnArrow.png" />
               </image>
               <HBox.margin>
                  <Insets bottom="5.0" left="8.0" right="5.0" top="5.0" />
               </HBox.margin>
            </ImageView>
            <Button alignment="CENTER" mnemonicParsing="false" onAction="#onReturn" prefHeight="83.0" prefWidth="154.0" styleClass="normalbutton" text="Return to&#10;Employee Add&#10;" textAlignment="CENTER" textFill="WHITE">
               <HBox.margin>
                  <Insets bottom="8.0" left="8.0" right="8.0" top="8.0" />
               </HBox.margin>
               <font>
                  <Font name="Franklin Gothic Medium" size="17.0" />
               </font>
            </Button>
         </children>
      </HBox>
      <Text fill="#898989" layoutX="697.0" layoutY="163.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Customer">
