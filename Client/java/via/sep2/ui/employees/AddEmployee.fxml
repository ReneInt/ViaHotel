            <Font name="Franklin Gothic Medium" size="18.0" />
         </font>
      </TextField>
      <TextField fx:id="lastNameInput" layoutX="492.0" layoutY="295.0" prefHeight="64.0" prefWidth="217.0" promptText="Type Last Name" styleClass="text_field">
