      </Text>
      <ComboBox fx:id="personType" layoutX="773.0" layoutY="295.0" prefHeight="64.0" prefWidth="217.0" />
      <TextField fx:id="emailInput" layoutX="239.0" layoutY="432.0" prefHeight="64.0" prefWidth="217.0" promptText="Type email" styleClass="text_field">
         <font>
            <Font name="Franklin Gothic Medium" size="18.0" />
         </font>
      </TextField>
    </children>
</AnchorPane>
