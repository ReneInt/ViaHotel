            </ImageView>
            <Button alignment="CENTER" mnemonicParsing="false" onAction="#onManage" prefHeight="83.0" prefWidth="154.0" styleClass="normalbutton" text="Manage&#10;Employees" textAlignment="CENTER" textFill="WHITE">
               <HBox.margin>
                  <Insets bottom="8.0" left="8.0" right="8.0" top="8.0" />
               </HBox.margin>
               <font>
                  <Font name="Franklin Gothic Medium" size="22.0" />
