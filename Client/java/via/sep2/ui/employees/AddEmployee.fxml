            <Font name="Cambria" size="55.0" />
         </font>
      </Text>
      <TextField fx:id="firstNameInput" layoutX="239.0" layoutY="295.0" prefHeight="64.0" prefWidth="217.0" promptText="Type First Name" styleClass="text_field">
