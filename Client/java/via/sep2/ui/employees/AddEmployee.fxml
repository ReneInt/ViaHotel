<AnchorPane prefHeight="900.0" prefWidth="1200.0" styleClass="mainPane_background" stylesheets="" xmlns="http://javafx.com/javafx/22" xmlns:fx="http://javafx.com/fxml/1" fx:controller="via.sep2.ui.employees.AddEmployeeController">
    <children>
        <HBox layoutX="467.0" layoutY="602.0" prefHeight="87.0" prefWidth="268.0" styleClass="button_background">
