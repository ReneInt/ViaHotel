                <ImageView fitHeight="77.0" fitWidth="77.0" pickOnBounds="true" preserveRatio="true">
                    <image>
                        <Image url="@../images/addNewUser.png" />
                    </image>
                    <HBox.margin>
                        <Insets bottom="5.0" left="8.0" right="5.0" top="5.0" />
                    </HBox.margin>
                </ImageView>
                <Button fx:id="buttonRegister" mnemonicParsing="false" onAction="#onRegister" prefHeight="83.0" prefWidth="154.0" styleClass="normalbutton" text="Add a new&#10;Employee" textFill="WHITE">
                    <HBox.margin>
                        <Insets bottom="8.0" left="8.0" right="8.0" top="8.0" />
                    </HBox.margin>
                    <font>
                        <Font name="Franklin Gothic Medium" size="25.0" />
                    </font>
                </Button>
            </children>
        </HBox>
        <Text fill="#878787" layoutX="398.0" layoutY="425.0" strokeType="OUTSIDE" strokeWidth="0.0">
            <font>
                <Font name="Cambria Bold" size="30.0" />
            </font>
        </Text>
        <Text fill="#878787" layoutX="398.0" layoutY="390.0" strokeType="OUTSIDE" strokeWidth="0.0">
            <font>
                <Font name="Cambria" size="30.0" />
            </font>
        </Text>
      <Label fx:id="messageLabel" alignment="CENTER" layoutX="439.0" layoutY="507.0" prefHeight="87.0" prefWidth="312.0" text="Label for stuff" textFill="#6b0000">
