<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="200.0" prefWidth="300.0" styleClass="mainPane_background" xmlns="http://javafx.com/javafx/22" xmlns:fx="http://javafx.com/fxml/1" fx:controller="via.sep2.ui.popup.PopupController">
    <children>
      <Label fx:id="notificationLabel" alignment="CENTER" layoutX="11.0" layoutY="7.0" prefHeight="27.0" prefWidth="300.0" styleClass="notificationLabel" text="New reservation created" textAlignment="CENTER" textFill="#00da16" underline="true">
         <font>
            <Font name="System Bold" size="18.0" />
         </font>
      </Label>
        <Label fx:id="messageLabel" alignment="TOP_CENTER" layoutY="49.0" prefHeight="102.0" prefWidth="315.0" styleClass="messageNotificationLabel" text="Label" textAlignment="CENTER" textFill="#e11010" wrapText="true">
            <font>
                <Font name="System Bold" size="12.0" />
            </font>
        </Label>
        <Label fx:id="errorLabel" alignment="CENTER" layoutX="3.0" layoutY="13.0" prefHeight="25.0" prefWidth="310.0" styleClass="errorLabel" text="ERROR!" textAlignment="CENTER" textFill="RED" underline="true">
            <font>
                <Font name="System Bold" size="18.0" />
            </font>
        </Label>
        <Label fx:id="warningLabel" alignment="CENTER" layoutX="3.0" layoutY="13.0" prefHeight="25.0" prefWidth="310.0" styleClass="warningLabel" text="WARNING!" textAlignment="CENTER" textFill="#ffbf00" underline="true">
            <font>
                <Font name="System Bold" size="18.0" />
            </font>
        </Label>
        <Label fx:id="successLabel" alignment="CENTER" layoutX="11.0" layoutY="7.0" prefHeight="27.0" prefWidth="300.0" styleClass="successLabel" text="SUCCESS!" textAlignment="CENTER" textFill="#00da16" underline="true">
            <font>
                <Font name="System Bold" size="18.0" />
            </font>
        </Label>
      <HBox alignment="CENTER" layoutX="58.0" layoutY="133.0" prefHeight="56.0" prefWidth="200.0">
         <children>
              <Button fx:id="closeButton" alignment="CENTER" contentDisplay="CENTER" mnemonicParsing="false" onAction="#onClose" styleClass="normalbutton" text="Close" textAlignment="CENTER" />
         </children>
      </HBox>
    </children>
</AnchorPane>
